{
  "name": "@cardanvil/frames-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Frame templates for Card Anvil, and the contract third-party frames are authored against.",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @cardanvil/frame-kit build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "test": "vitest run",
    "frames:validate": "pnpm --filter @cardanvil/frame-kit build && node packages/frame-kit/dist/cli/main.js validate",
    "frames:build": "pnpm --filter @cardanvil/frame-kit build && node packages/frame-kit/dist/cli/main.js build --out dist-frames"
  },
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^@cardanvil/(.*)$",
      "^[./]"
    ],
    "importOrderSeparation": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.13.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "volta": {
    "node": "24.16.0"
  }
}
