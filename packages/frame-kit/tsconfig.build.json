{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    // No source maps: `files` does not ship src, so a map would only point at
    // files that are not there.
    "declarationMap": false,
    "sourceMap": false,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  // Tests and their fixtures are not part of the published package. The
  // fixtures also import *.png / *.svg, which only Vite can resolve.
  "exclude": ["**/*.test.ts", "**/__fixtures__/**"]
}
