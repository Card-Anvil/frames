{
  "name": "@cardanvil/frame-kit",
  "version": "0.4.0",
  "description": "The contract Card Anvil frames are authored against: schemas, types, authoring helpers, and the distributable manifest format.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Card-Anvil/frames.git",
    "directory": "packages/frame-kit"
  },
  "files": [
    "dist",
    "schema",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./manifest": {
      "types": "./src/manifest/index.ts",
      "default": "./src/manifest/index.ts"
    },
    "./packaging": {
      "types": "./src/cli/index.ts",
      "default": "./src/cli/index.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "vite": "^6 || ^7",
    "zod": "^4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/cli/emitSchemas.js",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./manifest": {
        "types": "./dist/manifest/index.d.ts",
        "default": "./dist/manifest/index.js"
      },
      "./packaging": {
        "types": "./dist/cli/index.d.ts",
        "default": "./dist/cli/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/yazl": "^3.3.1",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "yazl": "^3.3.1"
  },
  "bin": {
    "frame-kit": "./dist/cli/main.js"
  }
}
